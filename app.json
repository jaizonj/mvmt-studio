{
  "expo": {
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f8e07bcd-0f16-4ff1-9ca3-c1ee643c3370"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.mvmtstudio.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "MVMT Studio uses your camera to record music video takes.",
        "NSMicrophoneUsageDescription": "MVMT Studio uses your microphone so your takes can include sound while you record to a track.",
        "NSPhotoLibraryAddUsageDescription": "MVMT Studio can save finished takes to your photo library when you choose to.",
        "NSPhotoLibraryUsageDescription": "MVMT Studio can save finished takes to your photo library when you choose to."
      },
      "supportsTablet": false
    },
    "name": "MVMT Studio",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101114",
          "image": "./assets/logo-lockup.png",
          "imageWidth": 230
        }
      ],
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": false,
          "cameraPermission": "MVMT Studio uses your camera to record music video takes.",
          "microphonePermission": "MVMT Studio uses your microphone so your takes can include sound while you record to a track."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "microphonePermission": "MVMT Studio uses your microphone so your takes can include sound while you record to a track."
        }
      ],
      [
        "expo-media-library",
        {
          "isAccessMediaLocationEnabled": false,
          "photosPermission": "MVMT Studio can save finished takes to your photo library when you choose to.",
          "savePhotosPermission": "MVMT Studio can save finished takes to your photo library when you choose to."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Anton-Regular.ttf",
            "./assets/fonts/BebasNeue-Regular.ttf",
            "./assets/fonts/Oswald-SemiBold.ttf",
            "./assets/fonts/Montserrat-ExtraBold.ttf",
            "./assets/fonts/ArchivoBlack-Regular.ttf",
            "./assets/fonts/Bangers-Regular.ttf",
            "./assets/fonts/LuckiestGuy-Regular.ttf",
            "./assets/fonts/Pacifico-Regular.ttf",
            "./assets/fonts/DancingScript-Bold.ttf",
            "./assets/fonts/PermanentMarker-Regular.ttf",
            "./assets/fonts/AlfaSlabOne-Regular.ttf",
            "./assets/fonts/Righteous-Regular.ttf",
            "./assets/fonts/Bungee-Regular.ttf",
            "./assets/fonts/Fredoka-SemiBold.ttf",
            "./assets/fonts/AbrilFatface-Regular.ttf",
            "./assets/fonts/PlayfairDisplay-Bold.ttf",
            "./assets/fonts/DMSerifDisplay-Regular.ttf",
            "./assets/fonts/Cinzel-Bold.ttf",
            "./assets/fonts/Audiowide-Regular.ttf",
            "./assets/fonts/Orbitron-Bold.ttf",
            "./assets/fonts/Caveat-Bold.ttf",
            "./assets/fonts/ShadowsIntoLight.ttf",
            "./assets/fonts/PressStart2P-Regular.ttf",
            "./assets/fonts/RubikMonoOne-Regular.ttf"
          ]
        }
      ]
    ],
    "scheme": "mvmtstudio",
    "slug": "mvmt-studio",
    "userInterfaceStyle": "dark",
    "version": "0.1.0",
    "owner": "prodjaizons-team"
  }
}
